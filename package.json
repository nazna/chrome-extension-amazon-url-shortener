{
  "name": "chrome-extension-amazon-url-shortener",
  "private": true,
  "type": "module",
  "version": "0.1.4",
  "description": "Amazon URL Shortener for Google Chrome",
  "license": "UNLICENSED",
  "author": "nazna <naznagg@gmail.com> (https://nazna.dev)",
  "engines": {
    "node": "25.x",
    "npm": "11.x"
  },
  "scripts": {
    "build": "zip amazon-url-shortener.zip ./manifest.json ./rulesets.json",
    "release": "npm run build && bumpp",
    "check": "biome check --write .",
    "bump": "npx npm-check-updates --upgrade --cooldown 3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "bumpp": "10.4.0"
  }
}
